{
  "name": "cranberries",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./app": "./src/app.tsx",
    "./seed": "./src/seed.ts",
    "./server": "./src/server.ts",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./style.css": "./src/style.css"
  },
  "bin": {
    "cranberries": "./bin/cranberries.js"
  },
  "files": [
    "bin",
    "src",
    "sql",
    "scripts/sql.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sql": "node scripts/sql.js",
    "test": "tsx --test test/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 test/*.integration.ts",
    "test:db:local": "bash scripts/test-db-local.sh"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@ovst/usl": "^0.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "tsx": "^4.23.15"
  }
}
